# --- Database -----------------------------------------------------------
# Used by FastAPI / SQLAlchemy (asyncpg driver)
# For local dev, point at the Docker container on localhost:5432
# For production, swap to your AWS RDS endpoint
DATABASE_URL=postgresql+asyncpg://resume_user:secret@localhost:5432/resume_db

# Used only by docker-compose to initialise the PostgreSQL container
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=secret
POSTGRES_DB=resume_db

# --- OpenAI -------------------------------------------------------------
# Never logged or exposed in API responses
OPENAI_API_KEY=sk-...

# --- JWT ----------------------------------------------------------------
# Use a long random string - never expose in logs or responses
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed origins (your Vercel frontend URL)
ALLOWED_ORIGIN=https://your-frontend.vercel.app

# --- App ----------------------------------------------------------------
ENVIRONMENT=development
